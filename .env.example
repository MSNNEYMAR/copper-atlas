# Copper Atlas — Environment Variables
# Copy this file to .env and adjust for your environment

# Database (PostgreSQL 16 + PostGIS)
DATABASE_URL=postgresql+asyncpg://atlas:atlas_dev@localhost:5432/copper_atlas
DATABASE_URL_SYNC=postgresql://atlas:atlas_dev@localhost:5432/copper_atlas

# Redis
REDIS_URL=redis://localhost:6379/0

# Martin Tile Server
MARTIN_URL=http://localhost:3000

# API
API_PORT=8000
LOG_LEVEL=DEBUG
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# OpenTelemetry (optional for local dev)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MARTIN_URL=http://localhost:3000
