# ============================================================================
# Copper Atlas — Martin Tile Server Dockerfile (Railway deployment)
# ============================================================================

FROM ghcr.io/maplibre/martin:v0.15.3

# Martin connects directly to PostGIS via DATABASE_URL env var
# All tile SQL functions are auto-discovered (martin_tile_* prefix)
# Configuration is via environment variables

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:3000/health || exit 1

CMD ["martin"]
